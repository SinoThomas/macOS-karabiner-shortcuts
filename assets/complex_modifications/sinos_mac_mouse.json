{
  "title": "Sino's mac utilities with mouse buttons",
  "maintainers": ["sino"],
  "homepage": "https://github.com/SinoThomas/macOS-karabiner-shortcuts",
  "import_url": "karabiner://karabiner/assets/complex_modifications/import?url=https://raw.githubusercontent.com/SinoThomas/macOS-karabiner-shortcuts/master/sinos_mac_utilities.json",
  "rules": [
    {
      "description": "Mouse Button 4              Cmd [    Back (skip Idea, VSCode)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "pointing_button": "button4" },
          "to": [{ "key_code": "open_bracket", "modifiers": ["left_command"] }],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.jetbrains\\.intellij$",
                "^com\\.jetbrains\\.intellij-EAP$",
                "^com\\.microsoft\\.VSCode$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Mouse Button 5              Cmd ]    Forward (skip Idea, VSCode)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "pointing_button": "button5" },
          "to": [{ "key_code": "close_bracket", "modifiers": ["left_command"] }],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.jetbrains\\.intellij$",
                "^com\\.jetbrains\\.intellij-EAP$",
                "^com\\.microsoft\\.VSCode$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Mouse Button 6 + [1,2]        Ctrl [LeftArrow,RightArrow]      [Previous,Next] Desktop",
      "manipulators": [
        {
          "type": "basic",
          "from": { "pointing_button": "button6" },
          "to": [{ "set_variable": { "name": "mouse_button6_held", "value": 1 } }],
          "to_after_key_up": [{ "set_variable": { "name": "mouse_button6_held", "value": 0 } }]
        },
        {
          "type": "basic",
          "from": { "pointing_button": "button1" },
          "conditions": [{ "type": "variable_if", "name": "mouse_button6_held", "value": 1 }],
          "to": [{ "key_code": "left_arrow", "modifiers": ["left_control"] }]
        },
        {
          "type": "basic",
          "from": { "pointing_button": "button2" },
          "conditions": [{ "type": "variable_if", "name": "mouse_button6_held", "value": 1 }],
          "to": [{ "key_code": "right_arrow", "modifiers": ["left_control"] }]
        }
      ]
    }
  ]
}
