{
  "title": "Sino's mac open projects",
  "maintainers": ["sino"],
  "homepage": "https://github.com/SinoThomas/macOS-karabiner-shortcuts",
  "import_url": "karabiner://karabiner/assets/complex_modifications/import?url=https://raw.githubusercontent.com/SinoThomas/macOS-karabiner-shortcuts/master/sinos_mac_open_apps.json",
  "rules": [
    {
      "description": "Fn + 0      Run Command: openProj 0",
      "manipulators": [{
        "type": "basic",
        "from": { "key_code": "0", "modifiers": { "mandatory": ["fn"] } },
        "to": [{ "shell_command": "~/-/openProjects.sh --key 0" }]
      }]
    },
    {
      "description": "Fn + 1      Run Command: openProj 1",
      "manipulators": [{
        "type": "basic", 
        "from": { "key_code": "1", "modifiers": { "mandatory": ["fn"] } }, 
